# ============================================================
#  Configuration de l'application — Registre ICM
#  Copiez ce fichier en « .env » et remplacez les valeurs.
# ============================================================

# Nom affiché dans l'en-tête
PAROISSE=In Christ Ministries

# Clé de sécurité des sessions : mettez une longue chaîne aléatoire (par
# exemple la sortie de : python -c "import secrets; print(secrets.token_hex(32))")
# Si vous laissez la valeur d'exemple ci-dessous (ou rien du tout),
# l'application en génère une elle-même à chaque démarrage — plus sûr que
# d'utiliser une valeur fixe, mais tout le monde est déconnecté à chaque
# redémarrage. Mettez une vraie valeur ici pour une installation durable.
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire

# Comptes et rôles
#  - secretaire (compte ADMIN_*, toujours actif) : accès complet — saisie,
#    modification, suppression, import, export.
#  - pasteur (facultatif) : accès complet également, exactement comme le
#    secrétariat — un compte séparé pour savoir qui a fait quoi. Laissez
#    PASTEUR_USER vide pour ne pas créer ce compte.
#  - visiteur (facultatif) : consultation seule — recherche, fiche, carte
#    imprimable, sans pouvoir rien modifier, importer ni exporter. Laissez
#    VISITEUR_USER vide pour ne pas créer ce compte.
#  Changez ce mot de passe d'exemple avant toute mise en service réelle.
ADMIN_USER=admin
ADMIN_PASSWORD=icm2026

PASTEUR_USER=
PASTEUR_PASSWORD=

VISITEUR_USER=
VISITEUR_PASSWORD=

# Base de données
#  - laisser vide  -> SQLite local (fichier registre.db), rien à installer
#  - Supabase      -> coller ici l'URL PostgreSQL du projet, par exemple :
#    postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
#    (dans ce cas, décommentez psycopg dans requirements.txt)
DATABASE_URL=

PORT=5000

# Mode debug Flask : à garder à 1 seulement sur votre propre poste, pour le
# développement. Sur tout déploiement accessible par d'autres personnes
# (réseau local ou Internet), mettez FLASK_DEBUG=0 — le mode debug expose un
# débogueur interactif qui permet d'exécuter du code arbitraire sur le
# serveur à quiconque atteint une page d'erreur.
FLASK_DEBUG=1

# Cookies de session marqués « Secure » (envoyés uniquement en HTTPS) :
# activé par défaut dès que FLASK_DEBUG=0. Si vous déployez volontairement
# en HTTP simple (réseau local sans certificat), mettez explicitement
# FORCER_HTTPS=0 ci-dessous, sinon la connexion échouera silencieusement.
# FORCER_HTTPS=0
