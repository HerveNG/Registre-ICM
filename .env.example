# ============================================================
#  Configuration de l'application — Registre ICM
#  Copiez ce fichier en « .env » et remplacez les valeurs.
# ============================================================

# Nom affiché dans l'en-tête
PAROISSE=In Christ Ministries

# Clé de sécurité des sessions : mettez une longue chaîne aléatoire
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire

# Compte du secrétariat
ADMIN_USER=admin
ADMIN_PASSWORD=icm2026

# Base de données
#  - laisser vide  -> SQLite local (fichier registre.db), rien à installer
#  - Supabase      -> coller ici l'URL PostgreSQL du projet, par exemple :
#    postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
#    (dans ce cas, décommentez psycopg dans requirements.txt)
DATABASE_URL=

PORT=5000
FLASK_DEBUG=1
