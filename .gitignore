# ============================================================
#  ICM — Registre des baptêmes & mariages
#  Fichiers à ne jamais envoyer sur GitHub
# ============================================================

# Secrets : jamais le vrai fichier, seulement .env.example
.env

# Base de données locale (version Flask / SQLite)
instance/
*.db
*.sqlite
*.sqlite3

# Photos des fidèles : données personnelles, ne doivent pas être publiques.
# Hors de static/ (tout ce qui est dans static/ est servi sans authentification
# par Flask) : voir la route protégée /photos/<fichier> dans app.py.
photos/*
!photos/.gitkeep
# Ancien emplacement (avant durcissement) : gardé au cas où une installation
# existante aurait encore des fichiers ici avant la migration automatique.
static/photos/*
!static/photos/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Tests (voir tests/README.md)
.pytest_cache/

# Version bureau (exécutable Windows) : artefacts de construction, jamais
# le résultat compilé — voir desktop/README.md pour reconstruire le .exe
desktop/build/
desktop/dist/
desktop/*.spec
desktop/icone.ico
pip_install_log.txt

# Version Android (Capacitor) : dépendances et artefacts de build, jamais le
# résultat compilé — voir docs/ANDROID-BUILD.md pour reconstruire l'APK/AAB.
# Le dossier android/ lui-même EST versionné (projet natif généré une seule
# fois par `npx cap add android`, puis synchronisé, pas régénéré à chaque
# build) ; seuls ses propres artefacts de compilation sont ignorés via
# android/.gitignore (build/, .gradle/, local.properties, *.jks, *.keystore,
# signing.properties...).
node_modules/
npm-debug.log*

# Fichiers système
.DS_Store
Thumbs.db
